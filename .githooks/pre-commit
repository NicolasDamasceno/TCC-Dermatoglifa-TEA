#!/bin/sh
# Bloqueia commits com identidade diferente da pessoal e arquivos que
# possam conter dados de participantes. Ativar com:
#   git config core.hooksPath .githooks

NOME_ESPERADO="Nicolas Damasceno"
EMAIL_ESPERADO="152975012+NicolasDamasceno@users.noreply.github.com"

NOME=$(git config user.name)
EMAIL=$(git config user.email)

if [ "$NOME" != "$NOME_ESPERADO" ] || [ "$EMAIL" != "$EMAIL_ESPERADO" ]; then
  echo "ERRO: identidade git inesperada: $NOME <$EMAIL>"
  echo "Configure: git config user.name \"$NOME_ESPERADO\""
  echo "           git config user.email \"$EMAIL_ESPERADO\""
  exit 1
fi

# Arquivos adicionados/modificados neste commit
ARQUIVOS=$(git diff --cached --name-only --diff-filter=ACMR)

# 1) Formatos que podem conter digitais ou dados de participantes, em qualquer pasta.
POR_FORMATO=$(printf '%s\n' "$ARQUIVOS" | grep -Ei \
  '\.(png|jpe?g|bmp|tiff?|wsq|jp2|gif|webp|raw|csv|tsv|xlsx?|parquet|npy|npz|pkl|db|sqlite3?|env)$')

# 2) Qualquer arquivo em pastas com nome de dados, exceto código-fonte e texto
#    de documentação (ex.: a pasta de código Pacientes/ do back-end é permitida).
POR_PASTA=$(printf '%s\n' "$ARQUIVOS" | grep -Ei \
  '(^|/)(dados|dataset[^/]*|data|participantes|pacientes|coletas|uploads)/' \
  | grep -Evi '\.(cs|csproj|py|ts|tsx|js|jsx|css|md)$')

PROIBIDOS=$(printf '%s\n%s\n' "$POR_FORMATO" "$POR_PASTA" | grep -v '^$' \
  | grep -Ev '^documentacao/|^aplicacao/front/(public|src/assets)/' )

if [ -n "$PROIBIDOS" ]; then
  echo "ERRO: arquivos que podem conter dados de participantes:"
  printf '  %s\n' $PROIBIDOS
  echo "Dados de treino e digitais ficam apenas na máquina local."
  exit 1
fi

# Pesos de modelos (ADR-0005): só modelos treinados com dados sintéticos,
# e apenas nas pastas liberadas.
PESOS=$(printf '%s\n' "$ARQUIVOS" | grep -Ei '\.(keras|h5|onnx|pt|tflite)$' \
  | grep -Ev '^treino/modelos/sinteticos/|^modelo_producao/demo/' )

if [ -n "$PESOS" ]; then
  echo "ERRO: pesos de modelo fora das pastas de modelos sintéticos:"
  printf '  %s\n' $PESOS
  echo "Pesos treinados com dados reais ficam fora do Git (ADR-0005)."
  exit 1
fi

exit 0
