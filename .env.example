# Variáveis do compose.yaml. Copie para ".env" (ignorado pelo Git) e troque a senha.
# NUNCA coloque valores reais neste arquivo.

POSTGRES_DB=dermatoglifia
POSTGRES_USER=dermatoglifia
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORTA=5432

IA_PORTA=8000
# IMPRESSAO (padrão) ou ESPELHADA: igual a Inferencia__ConvencaoAlca da API (ADR-0002)
DERMATOGLIFIA_CONVENCAO_ALCA=IMPRESSAO
