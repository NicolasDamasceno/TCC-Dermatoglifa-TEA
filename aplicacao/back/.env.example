# Exemplo de configuração do back-end. Copie para ".env" (ignorado pelo Git) ou,
# de preferência, use "dotnet user-secrets" em desenvolvimento (ver README).
# NUNCA coloque valores reais neste arquivo.

# Conexão com o PostgreSQL
ConnectionStrings__Banco=Host=localhost;Port=5432;Database=dermatoglifia;Username=dermatoglifia;Password=troque-esta-senha

# Chave de assinatura do JWT: 32 bytes aleatórios em base64 (openssl rand -base64 32)
Jwt__Chave=gere-com-openssl-rand-base64-32

# Primeiro administrador: criado na primeira partida se não existir nenhum
AdminInicial__Email=admin@exemplo.local
AdminInicial__Senha=troque-esta-senha-10
AdminInicial__Nome=Administrador

# As chaves abaixo entram nos próximos marcos (doc 08, seção 9):
# Armazenamento__Diretorio=/var/lib/dermatoglifia/imagens
# Armazenamento__Chaves__1=<256 bits aleatórios em base64>
# Inferencia__UrlBase=http://localhost:8000
